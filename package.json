{
  "name": "monalix-store",
  "private": true,
  "version": "1.0.1",
  "description": "MONALIX - Logiciel de gestion commerciale",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Charles-Monalix/monalix-store.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "electron-updater": "^6.8.9",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.35.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.monalix.store",
    "productName": "MONALIX",
    "artifactName": "Monalix-Setup-${version}.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "public/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Charles-Monalix",
      "repo": "monalix-store",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/monalix.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MONALIX",
      "deleteAppDataOnUninstall": false
    }
  }
}
